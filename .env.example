# Copiar a .env y ajustar las credenciales antes de levantar los contenedores.

NODE_ENV=development
PORT=3000

# Puerto publicado en el host (docker-compose.yml)
APP_PORT=8080

# Contraseña del superusuario de PostgreSQL. Cambiarla en producción.
POSTGRES_PASSWORD=origen_db_2024

DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app
DB_PASSWORD=origen_app_2024

# Secreto para firmar sesiones. Generar uno largo y aleatorio.
SESSION_SECRET=cambiar_por_un_valor_largo_y_aleatorio

UPLOADS_DIR=/app/uploads
